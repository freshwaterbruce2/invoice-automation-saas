#!/usr/bin/env sh

echo "🚀 Running pre-push checks..."

# Run tests
echo "🧪 Running tests..."
npm test -- --run
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Push aborted."
  exit 1
fi

# Check for console.logs in staged files
echo "🔍 Checking for console.logs..."
git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|jsx|ts|tsx)$' | xargs grep -l 'console\.log' | grep -v test
if [ $? -eq 0 ]; then
  echo "⚠️  Warning: console.log statements found. Consider removing them."
fi

# Run build to ensure it works
echo "🔨 Testing build..."
npm run build
if [ $? -ne 0 ]; then
  echo "❌ Build failed. Push aborted."
  exit 1
fi

echo "✅ All pre-push checks passed!"