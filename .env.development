# Development Environment Variables
# Copy this file to .env.local and update with your development values

# Application
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001/api

# Stripe (Test Mode)
VITE_STRIPE_PUBLIC_KEY=pk_test_51234567890abcdefghijklmnopqrstuvwxyz
STRIPE_SECRET_KEY=sk_test_51234567890abcdefghijklmnopqrstuvwxyz
STRIPE_WEBHOOK_SECRET=whsec_test1234567890

# Supabase (Local Development)
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_KEY=your-local-service-key

# Sentry (Development)
VITE_SENTRY_DSN=https://dev@sentry.io/development
VITE_SENTRY_ENVIRONMENT=development

# Analytics (Optional in dev)
VITE_GA_TRACKING_ID=
VITE_MIXPANEL_TOKEN=

# Feature Flags
VITE_ENABLE_MOCK_API=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SENTRY=false

# Development Tools
VITE_SHOW_PERFORMANCE_MONITOR=true
VITE_SHOW_DEBUG_INFO=true